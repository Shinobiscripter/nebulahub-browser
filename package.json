{
	"name": "nebulahub-browser",
	"version": "1.0.0",
	"description": "NebulaHub's space-themed browser, powered by Scramjet.",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"start": "node src/index.js",
		"check": "eslint src public/index.js public/search.js public/register-sw.js public/sw.js",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"keywords": [
		"proxy",
		"scramjet",
		"nebulahub"
	],
	"license": "AGPL-3.0-only",
	"dependencies": {
		"@fastify/static": "^9.0.0",
		"@mercuryworkshop/bare-mux": "^2.1.9",
		"@mercuryworkshop/libcurl-transport": "^1.5.2",
		"@mercuryworkshop/scramjet": "https://github.com/MercuryWorkshop/scramjet/releases/download/v1.1.0/mercuryworkshop-scramjet-1.1.0.tgz",
		"@mercuryworkshop/wisp-js": "^0.4.1",
		"fastify": "^5.7.4",
		"ws": "^8.18.3"
	},
	"devDependencies": {
		"eslint": "^9.13.0",
		"prettier": "^3.3.3"
	},
	"packageManager": "pnpm@10.18.3"
}
